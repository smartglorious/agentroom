{
  "name": "agentroom",
  "displayName": "AgentRoom — AI team group chat",
  "description": "Nhiều AI worker (Claude Code / Codex) với vai trò riêng cùng làm việc trong một group chat ngay trong VS Code.",
  "version": "0.4.0",
  "publisher": "agentroom",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.agentroom/workers.yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentroom",
          "title": "AgentRoom",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentroom": [
        {
          "type": "webview",
          "id": "agentroom.chat",
          "name": "Team Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "agentroom.init",
        "title": "AgentRoom: Tạo cấu hình workers mẫu"
      },
      {
        "command": "agentroom.reload",
        "title": "AgentRoom: Nạp lại workers.yaml"
      },
      {
        "command": "agentroom.stopAll",
        "title": "AgentRoom: Dừng tất cả worker"
      },
      {
        "command": "agentroom.consolidateMemory",
        "title": "AgentRoom: Gom trí nhớ worker"
      },
      {
        "command": "agentroom.newSkill",
        "title": "AgentRoom: Tạo skill mới"
      }
    ],
    "configuration": {
      "title": "AgentRoom",
      "properties": {
        "agentroom.maxAgentHops": {
          "type": "number",
          "default": 6,
          "description": "Số lượt agent→agent tối đa tính từ một tin nhắn của người dùng (chống vòng lặp)."
        },
        "agentroom.claudePath": {
          "type": "string",
          "default": "",
          "description": "Đường dẫn tới CLI claude (bỏ trống = tìm trong PATH)."
        },
        "agentroom.codexPath": {
          "type": "string",
          "default": "",
          "description": "Đường dẫn tới CLI codex (bỏ trống = tìm trong PATH)."
        },
        "agentroom.contextMessages": {
          "type": "number",
          "default": 30,
          "description": "Số tin nhắn gần nhất đưa vào prompt mỗi lượt."
        },
        "agentroom.memoryBudgetChars": {
          "type": "number",
          "default": 12000,
          "description": "Số ký tự tối đa của SOUL + trí nhớ + nhật ký đưa vào persona mỗi lượt."
        },
        "agentroom.inspector.keepTurns": {
          "type": "number",
          "default": 300,
          "description": "Số lượt gần nhất lưu cho Context Inspector (0 = tắt). Thư mục lưu chứa code nên bị git ignore."
        },
        "agentroom.pricing": {
          "type": "object",
          "default": {},
          "description": "Bảng giá để ước tính chi phí Codex, USD cho 1 triệu token. Ví dụ: {\"gpt-5.4\": {\"input\": 2.5, \"cachedInput\": 0.25, \"output\": 10}}. Model không có trong bảng sẽ không có chi phí."
        },
        "agentroom.hookPort": {
          "type": "number",
          "default": 47321,
          "description": "Cổng webhook (chỉ nghe trên 127.0.0.1)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test out-test/*.test.js",
    "package": "npm run build && npx -y @vscode/vsce package",
    "test:live": "node scripts/live/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex-sdk": "0.164.0",
    "croner": "10.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
