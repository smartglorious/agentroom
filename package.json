{
  "name": "agentroom",
  "displayName": "AgentRoom — AI team group chat",
  "description": "Nhiều AI worker (Claude Code / Codex) với vai trò riêng cùng làm việc trong một group chat ngay trong VS Code.",
  "version": "0.1.0",
  "publisher": "agentroom",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.agentroom/workers.yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentroom",
          "title": "AgentRoom",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentroom": [
        {
          "type": "webview",
          "id": "agentroom.chat",
          "name": "Team Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "agentroom.init",
        "title": "AgentRoom: Tạo cấu hình workers mẫu"
      },
      {
        "command": "agentroom.reload",
        "title": "AgentRoom: Nạp lại workers.yaml"
      },
      {
        "command": "agentroom.stopAll",
        "title": "AgentRoom: Dừng tất cả worker"
      }
    ],
    "configuration": {
      "title": "AgentRoom",
      "properties": {
        "agentroom.maxAgentHops": {
          "type": "number",
          "default": 6,
          "description": "Số lượt agent→agent tối đa tính từ một tin nhắn của người dùng (chống vòng lặp)."
        },
        "agentroom.claudePath": { "type": "string", "default": "", "description": "Đường dẫn tới CLI claude (bỏ trống = tìm trong PATH)." },
        "agentroom.codexPath": { "type": "string", "default": "", "description": "Đường dẫn tới CLI codex (bỏ trống = tìm trong PATH)." },
        "agentroom.contextMessages": {
          "type": "number",
          "default": 30,
          "description": "Số tin nhắn gần nhất đưa vào prompt mỗi lượt."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test out-test/*.test.js",
    "package": "npm run build && npx -y @vscode/vsce package"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex-sdk": "0.164.0",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
