{
  "name": "agentroom",
  "displayName": "AgentRoom — AI team group chat",
  "description": "%description%",
  "version": "0.14.9",
  "publisher": "agentroom",
  "license": "MIT",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.agentroom/workers.yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentroom",
          "title": "AgentRoom",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentroom": [
        {
          "type": "webview",
          "id": "agentroom.chat",
          "name": "Team Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "agentroom.init",
        "title": "%cmd.init%"
      },
      {
        "command": "agentroom.reload",
        "title": "%cmd.reload%"
      },
      {
        "command": "agentroom.stopAll",
        "title": "%cmd.stopAll%"
      },
      {
        "command": "agentroom.reportIssue",
        "title": "%cmd.reportIssue%"
      },
      {
        "command": "agentroom.measureContext",
        "title": "%cmd.measureContext%"
      },
      {
        "command": "agentroom.exportIssues",
        "title": "%cmd.exportIssues%"
      },
      {
        "command": "agentroom.cleanup",
        "title": "%cmd.cleanup%"
      },
      {
        "command": "agentroom.cleanup.restore",
        "title": "%cmd.cleanup.restore%"
      },
      {
        "command": "agentroom.consolidateMemory",
        "title": "%cmd.consolidateMemory%"
      },
      {
        "command": "agentroom.newSkill",
        "title": "%cmd.newSkill%"
      },
      {
        "command": "agentroom.takeOver",
        "title": "%cmd.takeOver%"
      },
      {
        "command": "agentroom.checkHosts",
        "title": "%cmd.checkHosts%"
      },
      {
        "command": "agentroom.telegram.setup",
        "title": "%cmd.telegram.setup%"
      },
      {
        "command": "agentroom.telegram.pair",
        "title": "%cmd.telegram.pair%"
      },
      {
        "command": "agentroom.telegram.unpair",
        "title": "%cmd.telegram.unpair%"
      },
      {
        "command": "agentroom.telegram.setPin",
        "title": "%cmd.telegram.setPin%"
      },
      {
        "command": "agentroom.telegram.disable",
        "title": "%cmd.telegram.disable%"
      }
    ],
    "configuration": {
      "title": "AgentRoom",
      "properties": {
        "agentroom.maxAgentHops": {
          "type": "number",
          "default": 6,
          "description": "%cfg.maxAgentHops%"
        },
        "agentroom.claudePath": {
          "type": "string",
          "default": "",
          "description": "%cfg.claudePath%"
        },
        "agentroom.codexPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.codexPath%"
        },
        "agentroom.contextMessages": {
          "type": "number",
          "default": 30,
          "description": "%cfg.contextMessages%"
        },
        "agentroom.memoryBudgetChars": {
          "type": "number",
          "default": 12000,
          "description": "%cfg.memoryBudgetChars%"
        },
        "agentroom.inspector.keepTurns": {
          "type": "number",
          "default": 300,
          "description": "%cfg.inspector.keepTurns%"
        },
        "agentroom.pricing": {
          "type": "object",
          "default": {},
          "description": "%cfg.pricing%"
        },
        "agentroom.hookPort": {
          "type": "number",
          "default": 47321,
          "description": "%cfg.hookPort%"
        },
        "agentroom.telegram.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%cfg.telegram.enabled%"
        },
        "agentroom.telegram.detail": {
          "type": "string",
          "enum": [
            "summary",
            "full",
            "alerts"
          ],
          "default": "summary",
          "scope": "machine",
          "description": "%cfg.telegram.detail%"
        },
        "agentroom.telegram.approveFromPhone": {
          "type": "string",
          "enum": [
            "safe",
            "none"
          ],
          "default": "safe",
          "scope": "machine",
          "description": "%cfg.telegram.approveFromPhone%"
        },
        "agentroom.telegram.summaryChars": {
          "type": "number",
          "default": 600,
          "minimum": 100,
          "maximum": 3000,
          "scope": "machine",
          "description": "%cfg.telegram.summaryChars%"
        },
        "agentroom.telegram.quietHours": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%cfg.telegram.quietHours%"
        },
        "agentroom.cleanup.turnsOlderThanDays": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%cfg.cleanup.turnsOlderThanDays%"
        },
        "agentroom.planUsage.pollMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 1440,
          "description": "%cfg.planUsage.pollMinutes%"
        },
        "agentroom.agentDebounceMs": {
          "type": "number",
          "default": 8000,
          "minimum": 0,
          "maximum": 60000,
          "description": "%cfg.agentDebounceMs%"
        },
        "agentroom.language": {
          "type": "string",
          "enum": [
            "vi",
            "en",
            "auto"
          ],
          "default": "vi",
          "description": "%cfg.language%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test out-test/*.test.js",
    "package": "npm run build && npx -y @vscode/vsce package",
    "test:live": "node scripts/live/run.mjs",
    "test:ssh": "node scripts/live/run.mjs ssh",
    "bench:tokens": "node scripts/live/run.mjs bench"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex-sdk": "0.164.0",
    "croner": "10.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%untrusted%"
    }
  },
  "bin": {
    "agentroom-daemon": "dist/daemon.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smartglorious/agentroom.git"
  }
}
