{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "vscode"
    ],
    "noEmit": true,
    "paths": {
      "agentroom:plugins": ["./src/plugins/private.ts", "./src/plugins/none.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "scripts/live"
  ]
}
